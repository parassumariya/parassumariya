<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400" width="1200" height="400">
  <defs>
    <!-- Backgrounds & Gradients -->
    <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%"   stop-color="#020610"/>
      <stop offset="60%"  stop-color="#07122a"/>
      <stop offset="100%" stop-color="#0d1f3f"/>
    </linearGradient>
    <linearGradient id="mountainGlow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%"   stop-color="#003d6b" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#020610" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="peakGlow" cx="72%" cy="60%" r="30%">
      <stop offset="0%"   stop-color="#004f82" stop-opacity="0.5"/>
      <stop offset="100%" stop-color="#020610" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="cyanGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%"   stop-color="#00d2ff" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#00d2ff" stop-opacity="0"/>
    </radialGradient>
    <!-- Text glow filter -->
    <filter id="textGlow" x="-20%" y="-40%" width="140%" height="180%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="softGlow" x="-10%" y="-30%" width="120%" height="160%">
      <feGaussianBlur stdDeviation="8" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>

    <!-- ════ CSS ANIMATIONS ════ -->
    <style>
      /* Twinkling stars */
      @keyframes twinkle1 {
        0%,100% { opacity:0.2; } 50% { opacity:1.0; }
      }
      @keyframes twinkle2 {
        0%,100% { opacity:0.8; } 50% { opacity:0.1; }
      }
      @keyframes twinkle3 {
        0%,100% { opacity:0.5; } 30% { opacity:1.0; } 70% { opacity:0.2; }
      }

      /* Cyan name glow pulse */
      @keyframes cyanPulse {
        0%,100% { filter: drop-shadow(0 0 6px #00d2ff) drop-shadow(0 0 12px #00d2ff); }
        50%      { filter: drop-shadow(0 0 14px #00d2ff) drop-shadow(0 0 28px #00b4d8); }
      }

      /* Blinking cursor */
      @keyframes blink {
        0%,49% { opacity:1; } 50%,100% { opacity:0; }
      }

      /* Text fade-in up */
      @keyframes fadeInUp {
        0%   { opacity:0; transform:translateY(18px); }
        100% { opacity:1; transform:translateY(0); }
      }

      /* Mountain shimmer */
      @keyframes shimmer {
        0%,100% { opacity:0.18; } 50% { opacity:0.32; }
      }

      /* Horizon glow pulse */
      @keyframes horizonPulse {
        0%,100% { opacity:0.06; } 50% { opacity:0.18; }
      }

      /* Apply animations */
      .tw1 { animation: twinkle1 2.4s ease-in-out infinite; }
      .tw2 { animation: twinkle2 1.8s ease-in-out infinite; }
      .tw3 { animation: twinkle3 3.1s ease-in-out infinite; }
      .tw4 { animation: twinkle1 4.0s ease-in-out infinite; }
      .tw5 { animation: twinkle2 2.9s ease-in-out infinite; }
      .tw6 { animation: twinkle3 2.1s ease-in-out infinite; }

      .name-cyan  { animation: cyanPulse 3s ease-in-out infinite; }
      .cursor     { animation: blink 1.1s step-end infinite; }
      .shimmer    { animation: shimmer 5s ease-in-out infinite; }
      .horizon    { animation: horizonPulse 4s ease-in-out infinite; }

      .fade1 { animation: fadeInUp 0.8s ease both 0.1s; }
      .fade2 { animation: fadeInUp 0.8s ease both 0.4s; }
      .fade3 { animation: fadeInUp 0.8s ease both 0.7s; }
      .fade4 { animation: fadeInUp 0.8s ease both 1.0s; }
      .fade5 { animation: fadeInUp 0.8s ease both 1.3s; }
    </style>
  </defs>

  <!-- ═══ SKY BACKGROUND ═══ -->
  <rect width="1200" height="400" fill="url(#skyGrad)"/>

  <!-- ═══ TWINKLING STARS ═══ -->
  <!-- Layer 1 — bright -->
  <circle class="tw1" cx="72"   cy="22"  r="1.4" fill="white"/>
  <circle class="tw3" cx="185"  cy="48"  r="1.1" fill="white"/>
  <circle class="tw2" cx="310"  cy="15"  r="1.5" fill="white"/>
  <circle class="tw5" cx="425"  cy="38"  r="0.9" fill="white"/>
  <circle class="tw4" cx="560"  cy="12"  r="1.3" fill="white"/>
  <circle class="tw1" cx="650"  cy="44"  r="1.0" fill="white"/>
  <circle class="tw6" cx="730"  cy="20"  r="1.6" fill="white"/>
  <circle class="tw2" cx="830"  cy="55"  r="1.2" fill="white"/>
  <circle class="tw3" cx="920"  cy="18"  r="1.4" fill="white"/>
  <circle class="tw5" cx="1010" cy="40"  r="1.0" fill="white"/>
  <circle class="tw1" cx="1090" cy="12"  r="1.3" fill="white"/>
  <circle class="tw4" cx="1170" cy="50"  r="1.1" fill="white"/>
  <!-- Layer 2 — dimmer, offset timings -->
  <circle class="tw3" cx="110"  cy="70"  r="0.8" fill="#c8e6ff"/>
  <circle class="tw2" cx="240"  cy="80"  r="0.7" fill="white"/>
  <circle class="tw4" cx="390"  cy="65"  r="0.9" fill="#d0efff"/>
  <circle class="tw6" cx="500"  cy="90"  r="0.6" fill="white"/>
  <circle class="tw1" cx="620"  cy="68"  r="0.8" fill="#c8e6ff"/>
  <circle class="tw5" cx="760"  cy="82"  r="0.7" fill="white"/>
  <circle class="tw3" cx="880"  cy="72"  r="0.9" fill="#d0efff"/>
  <circle class="tw2" cx="990"  cy="88"  r="0.6" fill="white"/>
  <circle class="tw4" cx="1130" cy="68"  r="0.8" fill="#c8e6ff"/>
  <!-- Layer 3 — tiny scattered -->
  <circle class="tw5" cx="55"   cy="110" r="0.5" fill="white"/>
  <circle class="tw1" cx="200"  cy="100" r="0.6" fill="white"/>
  <circle class="tw6" cx="470"  cy="105" r="0.5" fill="white"/>
  <circle class="tw2" cx="690"  cy="95"  r="0.6" fill="white"/>
  <circle class="tw3" cx="850"  cy="110" r="0.5" fill="white"/>
  <circle class="tw4" cx="1050" cy="100" r="0.6" fill="white"/>

  <!-- ═══ MOUNTAIN LAYERS ═══ -->
  <!-- Far background mountains -->
  <polygon
    points="420,320 500,210 580,255 660,185 740,225 820,165 900,205 980,170 1060,200 1140,175 1200,210 1200,400 420,400"
    fill="#0c1e3a" opacity="0.85"/>
  <!-- Mid mountains -->
  <polygon
    points="480,320 555,230 635,265 715,195 795,238 875,185 955,218 1035,188 1115,215 1200,200 1200,400 480,400"
    fill="#0e2444" opacity="0.9"/>
  <!-- Peak glow shimmer -->
  <ellipse class="shimmer" cx="870" cy="200" rx="130" ry="65" fill="url(#mountainGlow)"/>
  <!-- Foreground mountains -->
  <polygon
    points="560,400 625,265 705,295 785,230 870,275 950,215 1030,255 1110,225 1200,260 1200,400"
    fill="#080f1e" opacity="1"/>
  <!-- Mountain radial glow -->
  <ellipse cx="870" cy="220" rx="200" ry="100" fill="url(#peakGlow)"/>
  <!-- Horizon glow line -->
  <rect class="horizon" x="420" y="310" width="780" height="3" rx="1" fill="#00d2ff"/>

  <!-- ═══ LEFT FADE (so text is readable over mountains) ═══ -->
  <defs>
    <linearGradient id="leftFade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%"   stop-color="#020610" stop-opacity="0.92"/>
      <stop offset="28%"  stop-color="#020610" stop-opacity="0.70"/>
      <stop offset="55%"  stop-color="#020610" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#020610" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <rect x="0" y="0" width="800" height="400" fill="url(#leftFade)"/>

  <!-- ═══ TEXT CONTENT ═══ -->

  <!-- Role tags line with blinking cursor -->
  <text class="fade1" x="46" y="54"
    font-family="'Courier New',Courier,monospace" font-size="13"
    fill="#4a7a9b" letter-spacing="5">
    &gt;  developer    trader    builder    entrepreneur
  </text>
  <rect class="cursor fade1" x="596" y="40" width="9" height="16" fill="#4a7a9b" rx="1"/>

  <!-- "Hi, I'm" -->
  <text class="fade2" x="46" y="120"
    font-family="'Segoe UI',Arial,sans-serif" font-size="24"
    fill="#94a3b8" font-weight="400">
    Hi, I'm
  </text>

  <!-- "Paras" — white bold -->
  <text class="fade3" x="46" y="200"
    font-family="'Segoe UI',Arial,sans-serif" font-size="72"
    fill="#ffffff" font-weight="800"
    filter="url(#softGlow)">
    Paras
  </text>

  <!-- "Sumaria" — animated cyan glow -->
  <text class="fade3 name-cyan" x="310" y="200"
    font-family="'Segoe UI',Arial,sans-serif" font-size="72"
    fill="#00d2ff" font-weight="800">
    Sumaria
  </text>

  <!-- Subtitle -->
  <text class="fade4" x="46" y="245"
    font-family="'Segoe UI',Arial,sans-serif" font-size="16"
    fill="#00b4d8" font-weight="500" letter-spacing="0.8">
    Finance Enthusiast  |  Trader  |  Developer  |  Entrepreneur
  </text>

  <!-- Description bullets -->
  <text class="fade5" x="46" y="282"
    font-family="'Segoe UI',Arial,sans-serif" font-size="13"
    fill="#546e85">
    Building digital products  •  Exploring financial markets
  </text>
  <text class="fade5" x="46" y="302"
    font-family="'Segoe UI',Arial,sans-serif" font-size="13"
    fill="#546e85">
    Creating solutions  •  Learning &amp; growing every day
  </text>

  <!-- "Good Code Better Opportunities" — top right (italic cursive style) -->
  <text x="1090" y="58"
    font-family="Georgia,'Times New Roman',serif" font-size="17"
    fill="#ffffff" opacity="0.55" font-style="italic"
    transform="rotate(-10,1090,58)" text-anchor="middle">
    Good Code
  </text>
  <text x="1110" y="84"
    font-family="Georgia,'Times New Roman',serif" font-size="17"
    fill="#ffffff" opacity="0.55" font-style="italic"
    transform="rotate(-10,1110,84)" text-anchor="middle">
    Better
  </text>
  <text x="1095" y="112"
    font-family="Georgia,'Times New Roman',serif" font-size="17"
    fill="#00d2ff" opacity="0.7" font-style="italic"
    transform="rotate(-10,1095,112)" text-anchor="middle">
    Opportunities
  </text>

  <!-- Bottom fade-out -->
  <defs>
    <linearGradient id="bottomFade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%"   stop-color="#020610" stop-opacity="0"/>
      <stop offset="100%" stop-color="#020610" stop-opacity="0.95"/>
    </linearGradient>
  </defs>
  <rect x="0" y="340" width="1200" height="60" fill="url(#bottomFade)"/>
</svg>
